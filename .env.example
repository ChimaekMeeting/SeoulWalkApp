EXPO_PUBLIC_MAPBOX_PUBLIC_ACCESS_TOKEN=YOUR_MAPBOX_PUBLIC_ACCESS_TOKEN
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Kakao Developers 콘솔(https://developers.kakao.com)에서 앱 등록 후 발급되는 네이티브 앱 키.
# 등록 시 iOS/Android 각각 번들 ID(com.seoulwalkapp), 키해시(Android) 등록 필요.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY

# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=your-mapbox-secret-download-token (downloads:read scope)
# Needed locally to run `expo prebuild` / `expo run:android`. Get it from the team lead,
# never commit the real value. For EAS builds this is set via `eas secret:create` instead.
